FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 HF_HOME=/opt/models HF_HUB_OFFLINE=0
WORKDIR /app

COPY services/requirements-api.txt /tmp/requirements.txt
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /tmp/requirements.txt

# Bake the embedding model so startup needs no Hugging Face access.
RUN python -c "from sentence_transformers import SentenceTransformer as S; S('sentence-transformers/all-MiniLM-L6-v2', device='cpu')"

COPY data_ingestion/ data_ingestion/
COPY data_generation/ data_generation/
COPY services/ services/

RUN useradd --system --uid 10001 --home-dir /app app && chown -R app /opt/models
USER 10001
ENV HF_HUB_OFFLINE=1
EXPOSE 8000
CMD ["uvicorn", "services.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
